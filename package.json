{
  "name": "v1",
  "version": "1.0.0",
  "description": "A lightweight, web-based tool designed to help chess players learn and practice their opening repertoires.",
  "main": "server/server.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest",
    "start": "node server/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "babel-jest": "^30.3.0",
    "chess.js": "^1.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.8.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/setup.js",
      "<rootDir>/tests/"
    ],
    "moduleNameMapper": {
      "^https://cdn\\.jsdelivr\\.net/npm/chess\\.js(.*)$": "chess.js"
    }
  }
}
