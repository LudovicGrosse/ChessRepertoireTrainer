{
  "name": "v1",
  "version": "1.0.0",
  "description": "A lightweight, web-based tool designed to help chess players learn and practice their opening repertoires.",
  "main": "server/server.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest",
    "start": "node server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/setup.js",
      "<rootDir>/tests/"
    ]
  }
