# SMTP Configuration Template
# Create a .env file with your actual values

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# The public URL of your application (required for links in emails)
APP_URL=http://localhost:3000

# Lichess OAuth Configuration
# Lichess uses PKCE, so no registration or client secret is needed.
# Just use your domain name (or a descriptive string) as the Client ID.
LICHESS_CLIENT_ID=laboiteaouvertures.onrender.com
# For local dev: http://localhost:3000/api/lichess/callback
# For production (Render): https://laboiteaouvertures.onrender.com/api/lichess/callback
LICHESS_REDIRECT_URI=https://laboiteaouvertures.onrender.com/api/lichess/callback
